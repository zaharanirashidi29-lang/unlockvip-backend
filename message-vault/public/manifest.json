{
  "name": "ChatKeep",
  "short_name": "ChatKeep",
  "description": "Keep personal chat records on your phone and sync them.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#071412",
  "theme_color": "#0b1c1a",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
